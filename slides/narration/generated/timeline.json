    {
      "id": "promise-ordinary-call",
      "index": 0,
      "page": 1,
      "click": 0,
      "text": "Let's not start from the protocol format. Start from the code we actually want to write: an ordinary TypeScript method call.",
      "audioPublicPath": "narration/audio/s001-c000.mp3",
      "audioDurationMs": 500,
      "silentMs": 0,
      "transitionMs": 300,
      "leadInMs": 100,
      "tailMs": 150,
